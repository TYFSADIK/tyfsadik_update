{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "void-style": "off",
    "no-trailing-whitespace": "off",
    "attr-spacing": "off",
    "no-raw-characters": "off",
    "tel-non-breaking": "off",
    "no-redundant-role": "off",
    "wcag/h30": "off",
    "meta-charmap-utf8": "off"
  }
}
